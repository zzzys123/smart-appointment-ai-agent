# Generic OpenAI-compatible model configuration.
# Fill these values after choosing a provider. Common options:
# - qwen: get an API key from Alibaba Cloud Bailian / DashScope, then use its OpenAI-compatible base URL.
# - deepseek: get an API key from DeepSeek Platform, then use its OpenAI-compatible base URL for chat.
# - zhipu: get an API key from BigModel, then use its OpenAI-compatible base URL.
# - openai: get an API key from OpenAI Platform, then use its OpenAI base URL.
MODEL_PROVIDER=qwen
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Embeddings can use a different provider/model from the chat LLM.
# DeepSeek does not provide a general embedding API, so keep this as qwen/zhipu/openai if MODEL_PROVIDER=deepseek.
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

OPENWEATHER_API_KEY=your_openweather_api_key_here

# ---- RAG 检索配置（可插拔）----
# 检索策略：dense（纯向量）| hybrid（向量 + BM25 + RRF 融合）。默认 hybrid。
RETRIEVER_STRATEGY=hybrid
# 精排重排开关：true 开启后在粗排召回之后加一层重排（默认 false，避免增加实时查询延迟/额度）。
RERANK_ENABLED=false
# 重排器类型：llm（复用上面的 Chat 模型打分）| cross-encoder（本地模型，待实现）。默认 llm。
RERANKER_PROVIDER=llm

# 无答案兜底：Hybrid 中任一原始通道达到阈值才把候选交给 LLM。
# 阈值基于仓库演示知识校准，替换语料或 Embedding 模型后应重新评估。
RAG_NO_ANSWER_ENABLED=true
RAG_DENSE_MIN_SCORE=0.60
RAG_BM25_MIN_SCORE=8.0

# ---- Redis（共享会话、限流、预约锁与幂等）----
# 本地未启动 Redis 时可保持 false；Docker Compose 启动后改为 true。
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=smart-appointment
REDIS_SESSION_TTL_SECONDS=3600
REDIS_IDEMPOTENCY_TTL_SECONDS=86400
REDIS_APPOINTMENT_LOCK_SECONDS=15
REDIS_APPOINTMENT_LOCK_WAIT_SECONDS=5
REDIS_CHAT_LOCK_SECONDS=120
REDIS_CHAT_LOCK_WAIT_SECONDS=2
REDIS_RATE_LIMIT_REQUESTS=10
REDIS_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Azure OpenAI mode:
# If you set MODEL_PROVIDER=azure or EMBEDDING_PROVIDER=azure, also add the required AZURE_OPENAI_* values.
