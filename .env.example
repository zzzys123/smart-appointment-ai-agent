# Generic OpenAI-compatible model configuration.
# Fill these values after choosing a provider. Common options:
# - qwen: get an API key from Alibaba Cloud Bailian / DashScope, then use its OpenAI-compatible base URL.
# - deepseek: get an API key from DeepSeek Platform, then use its OpenAI-compatible base URL for chat.
# - zhipu: get an API key from BigModel, then use its OpenAI-compatible base URL.
# - openai: get an API key from OpenAI Platform, then use its OpenAI base URL.
MODEL_PROVIDER=qwen
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Embeddings can use a different provider/model from the chat LLM.
# DeepSeek does not provide a general embedding API, so keep this as qwen/zhipu/openai if MODEL_PROVIDER=deepseek.
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# ---- Token 与 API 成本统计（单价请按供应商当前账单配置）----
# Chat Token 来自模型响应 usage；Embedding SDK 不返回 usage，按字符数估算并明确标记。
EMBEDDING_ESTIMATED_CHARS_PER_TOKEN=2.0
# 单位：人民币元 / 100 万 Token。留空时只统计用量，不计算费用。
# 2026-08-19 国内参考：qwen3.7-plus 0-256K 限时价输入 1.6、输出 6.4；
# text-embedding-v3 同步调用 0.5。价格和优惠会变化，复制前必须复核官方页面。
LLM_INPUT_CNY_PER_1M_TOKENS=
LLM_OUTPUT_CNY_PER_1M_TOKENS=
EMBEDDING_CNY_PER_1M_TOKENS=
# 价格审计元数据；示例值请在使用前重新核对阿里云官方价格页。
MODEL_PRICING_PROFILE=
MODEL_PRICING_EFFECTIVE_DATE=
MODEL_PRICING_SOURCE_URL=https://help.aliyun.com/zh/model-studio/model-pricing
# 当前价格适用的单请求输入 Token 上限；超过后拒绝估算，避免套用错误阶梯。
MODEL_PRICING_MAX_INPUT_TOKENS=
# 线上每次咨询的聚合用量；默认不持久化，且永不保存原问题/答案/session_id。
MODEL_USAGE_LOG_ENABLED=true
MODEL_USAGE_PERSIST_ENABLED=false
MODEL_USAGE_PATH=data/observability/model_usage.jsonl

OPENWEATHER_API_KEY=your_openweather_api_key_here

# ---- RAG 检索配置（可插拔）----
# 检索策略：dense（纯向量）| hybrid（向量 + BM25 + RRF 融合）。默认 hybrid。
RETRIEVER_STRATEGY=hybrid
# 精排重排开关：true 开启后在粗排召回之后加一层重排（默认 false，避免增加实时查询延迟/额度）。
RERANK_ENABLED=false
# 重排器类型：llm（复用 Chat 模型打分）| cross-encoder（本地模型）。默认 llm。
RERANKER_PROVIDER=llm
# 重排模式：off | always | adaptive。默认保持 Golden v2 的 off 基线；评测后再显式启用。
RAG_RERANK_MODE=off
# adaptive 中普通歧义问题使用本地 Cross-Encoder；复杂规则边界与高风险查询选择 LLM。
RAG_ADAPTIVE_RERANKER_PROVIDER=cross-encoder
# 当前 Golden Set 中 Cross-Encoder 对部分语义查询有负收益，默认不自动路由；可显式开启实验。
RAG_ADAPTIVE_CROSS_ENCODER_ENABLED=false
RAG_ADAPTIVE_LLM_ENABLED=false
RAG_ADAPTIVE_DENSE_HIGH_SCORE=0.82
RAG_ADAPTIVE_BM25_HIGH_SCORE=12.0
# LLM 重排采用 0-10 评分；达到该阈值的候选可作为门控补充证据。
RAG_LLM_RERANK_MIN_SCORE=8.0
# 融合分中保留 Hybrid 粗排信号的权重；精排超时自动回退 Hybrid。
RAG_RERANK_RETRIEVAL_WEIGHT=0.35
RAG_RERANK_TIMEOUT_SECONDS=20
# Cross-Encoder 本地精排配置（RERANKER_PROVIDER=cross-encoder 时生效）。
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
# auto 自动选择可用设备，也可显式填写 cpu / cuda。
CROSS_ENCODER_DEVICE=auto
CROSS_ENCODER_BATCH_SIZE=16
CROSS_ENCODER_MAX_LENGTH=512
# true 时只从本机缓存加载模型，不访问模型仓库。
CROSS_ENCODER_LOCAL_FILES_ONLY=false

# 无答案兜底：Hybrid 中任一原始通道达到阈值才把候选交给 LLM。
# 阈值基于仓库演示知识校准，替换语料或 Embedding 模型后应重新评估。
RAG_NO_ANSWER_ENABLED=true
RAG_DENSE_MIN_SCORE=0.66
RAG_BM25_MIN_SCORE=8.0

# ---- RAG 链路观测 ----
# 结构化日志默认开启；JSONL 持久化和失败归档需显式开启。
RAG_TRACE_LOG_ENABLED=true
RAG_TRACE_PERSIST_ENABLED=false
RAG_FAILURE_ARCHIVE_ENABLED=false
# 默认只保存 query SHA-256，避免把手机号等原始输入落盘。
RAG_TRACE_INCLUDE_QUERY=false
RAG_TRACE_PATH=data/observability/retrieval_traces.jsonl
RAG_FAILURE_ARCHIVE_PATH=data/observability/failure_cases.jsonl

# ---- Redis（共享会话、限流、预约锁与幂等）----
# 本地未启动 Redis 时可保持 false；Docker Compose 启动后改为 true。
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=smart-appointment
REDIS_SESSION_TTL_SECONDS=3600
REDIS_IDEMPOTENCY_TTL_SECONDS=86400
REDIS_APPOINTMENT_LOCK_SECONDS=15
REDIS_APPOINTMENT_LOCK_WAIT_SECONDS=5
REDIS_CHAT_LOCK_SECONDS=120
REDIS_CHAT_LOCK_WAIT_SECONDS=2
REDIS_RATE_LIMIT_REQUESTS=10
REDIS_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Azure OpenAI mode:
# If you set MODEL_PROVIDER=azure or EMBEDDING_PROVIDER=azure, also add the required AZURE_OPENAI_* values.
